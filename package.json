{
  "name": "wireframe-mapper",
  "version": "0.1.0",
  "description": "DOM to wireframe mapper - generate clean mockups from live websites",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "mcp-server"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --outfile=dist/wireframe-mapper.js --format=iife",
    "build:dev": "esbuild src/main.ts --bundle --outfile=dist/wireframe-mapper.js --format=iife --sourcemap",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/wireframe-mapper.js --format=iife --watch",
    "serve": "bun scripts/dev-server.ts",
    "dev": "bun scripts/dev.ts",
    "build:shared": "bun --filter @wireframe-mapper/shared build",
    "build:mcp": "bun --filter wireframe-mapper-mcp build",
    "build:scripts": "bun scripts/build-mcp-wrapper.ts",
    "build:userscript": "bun scripts/build-userscript.ts",
    "build:all": "bun run build:shared && bun run build && bun run build:scripts && bun run build:mcp && bun run build:userscript",
    "verify:mcp": "bun --filter wireframe-mapper-mcp verify",
    "clean": "rm -rf dist packages/shared/dist mcp-server/dist scripts/mcp-wrapper.js",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "bun test --pass-with-no-tests",
    "lint": "bun run --silent lint:errors && bun run --silent format:check",
    "lint:fix": "bun run --silent autofix",
    "lint:errors": "oxlint -c .oxlintrc.jsonc --quiet --format=unix src/ scripts/",
    "lint:arch": "dependency-cruiser --config .dependency-cruiser.cjs --output-type err src scripts",
    "lint:dead": "knip --include files,dependencies,unlisted,binaries --reporter compact",
    "lint:dupes": "jscpd --config .jscpd.json",
    "format": "oxfmt --write -c .oxfmtrc.jsonc 'src/**/*.{ts,tsx,js,jsx,mjs}' 'scripts/**/*.{ts,tsx,js,jsx,mjs}'",
    "format:check": "oxfmt --check -c .oxfmtrc.jsonc 'src/**/*.{ts,tsx,js,jsx,mjs}' 'scripts/**/*.{ts,tsx,js,jsx,mjs}'",
    "autofix": "oxlint -c .oxlintrc.jsonc --fix src/ scripts/ && oxfmt --write -c .oxfmtrc.jsonc 'src/**/*.{ts,tsx,js,jsx,mjs}' 'scripts/**/*.{ts,tsx,js,jsx,mjs}'",
    "lint:audit": "bun scripts/quality/audit-oxlint-rules.ts",
    "check:links": "bun scripts/quality/check-links-local.ts",
    "agents:sync": "bun scripts/agents/sync-agents-md.ts --write",
    "agents:check": "bun scripts/agents/sync-agents-md.ts --check",
    "repo:bootstrap": "bun scripts/setup/bootstrap-git-config.ts",
    "prepare": "bun scripts/setup/bootstrap-prepare.ts",
    "validate": "bun scripts/validation/validate.ts",
    "validate:scale": "bun run --silent validate && bun run --silent lint:dead && bun run --silent lint:arch && bun run --silent lint:dupes && bun run --silent check:links"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@wireframe-mapper/shared": "workspace:*",
    "dependency-cruiser": "17.3.10",
    "esbuild": "^0.24.0",
    "jscpd": "4.0.8",
    "knip": "6.6.2",
    "lefthook": "2.1.4",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-plugin-complexity": "2.0.3",
    "oxlint-tsgolint": "0.19.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {}
}
